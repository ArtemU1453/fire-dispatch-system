# =========================================================================
# AI Dispatcher МЧС — example environment configuration.
# Copy to `.env` and adjust values. Never commit a real `.env`.
# =========================================================================

# --- Application ---
APP_NAME="AI Dispatcher МЧС"
APP_ENV=local            # local | dev | staging | production
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false           # true to emit structured JSON logs

# --- PostgreSQL ---
POSTGRES_HOST=localhost  # use "db" when running via docker-compose
POSTGRES_PORT=5432
POSTGRES_USER=dispatcher
POSTGRES_PASSWORD=dispatcher
POSTGRES_DB=dispatcher

# --- SQLAlchemy engine ---
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- CORS (JSON array) ---
CORS_ORIGINS=["*"]

# --- GIS / geocoding ---
GIS_PROVIDER=nominatim          # nominatim | photon | pelias | arcgis | fake
GIS_HTTP_TIMEOUT=10.0
GIS_USER_AGENT="ai-dispatcher-mchs/0.1 (+https://example.local)"
GIS_DEFAULT_LANGUAGE=ru
GIS_DEFAULT_COUNTRY_CODES=["ru"]
# Provider endpoints (override to use self-hosted instances)
GIS_NOMINATIM_URL=https://nominatim.openstreetmap.org
GIS_PHOTON_URL=https://photon.komoot.io
GIS_PELIAS_URL=https://api.geocode.earth/v1
# GIS_PELIAS_API_KEY=
GIS_ARCGIS_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer
# GIS_ARCGIS_TOKEN=
# --- GIS caching (Redis-ready; not wired yet) ---
GIS_CACHE_BACKEND=memory        # memory | none
GIS_CACHE_TTL_SECONDS=86400
GIS_CACHE_MAX_ENTRIES=10000
# GIS_REDIS_URL=redis://localhost:6379/0

# --- Search result caching (Redis-ready; short TTL) ---
SEARCH_CACHE_BACKEND=memory     # memory | none
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_CACHE_MAX_ENTRIES=5000
