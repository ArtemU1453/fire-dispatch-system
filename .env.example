# =========================================================================
# AI Dispatcher МЧС — example environment configuration.
# Copy to `.env` and adjust values. Never commit a real `.env`.
# =========================================================================

# --- Application ---
APP_NAME="AI Dispatcher МЧС"
APP_ENV=local            # local | dev | staging | production
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false           # true to emit structured JSON logs

# --- PostgreSQL ---
POSTGRES_HOST=localhost  # use "db" when running via docker-compose
POSTGRES_PORT=5432
POSTGRES_USER=dispatcher
POSTGRES_PASSWORD=dispatcher
POSTGRES_DB=dispatcher

# --- SQLAlchemy engine ---
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- CORS (JSON array) ---
CORS_ORIGINS=["*"]
