# Base URL of the AI Dispatcher МЧС backend API. No URLs are hard-coded in the app.
VITE_API_BASE_URL=/api/v1
# Request timeout (ms)
VITE_API_TIMEOUT=15000
# Auth endpoints (relative to VITE_API_BASE_URL)
VITE_AUTH_LOGIN_PATH=/admin/auth/login
VITE_AUTH_REFRESH_PATH=/admin/auth/refresh
VITE_AUTH_ME_PATH=/admin/auth/me
# Idle auto-logout (ms)
VITE_IDLE_TIMEOUT=1800000

# --- Dispatcher workspace (Frontend Stage 2) ---
# Real-time channel. Leave empty to derive ws[s]://<origin><path> automatically.
VITE_WS_URL=
VITE_WS_DISPATCHER_PATH=/ws/dispatcher
# Polling fallbacks (ms), used when the socket is not connected
VITE_POLL_INCIDENTS=15000
VITE_POLL_RESOURCES=20000
VITE_POLL_STATS=15000
VITE_POLL_LOG=12000
