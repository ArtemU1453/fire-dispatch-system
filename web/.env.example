# Base URL of the AI Dispatcher МЧС backend API. No URLs are hard-coded in the app.
VITE_API_BASE_URL=/api/v1
# Request timeout (ms)
VITE_API_TIMEOUT=15000
# Auth endpoints (relative to VITE_API_BASE_URL)
VITE_AUTH_LOGIN_PATH=/admin/auth/login
VITE_AUTH_REFRESH_PATH=/admin/auth/refresh
VITE_AUTH_ME_PATH=/admin/auth/me
# Idle auto-logout (ms)
VITE_IDLE_TIMEOUT=1800000
